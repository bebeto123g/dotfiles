{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "color": {
      "1": "blue",
      "2": "black"
    },
    "source": "$HOME/.config/fastfetch/ascii/arch.txt",
    "padding": {
      "top": 4,
      "right": 5
    },
    "height": 18
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "light_blue"
    },
  },
  "modules": [
    {
      "type": "title",
      "key": " ",
      "color": {
        "user": "light_blue",
        "at": "white",
        "host": "magenta"
      }
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌────────────────────────────────────────────────────────────────────┐"
    },
    {
      "type": "os",
      "key": "󰣇 os      ",
      "keycolor": "red"
    },
    {
      "type": "kernel",
      "key": " kernel  ",
      "keycolor": "red"
    },
    {
      "type": "de",
      "key": "󰕮 de      ",
      "keycolor": "green"
    },
    {
      "type": "wm",
      "key": " wm      ",
      "keycolor": "green"
    },
    {
      "type": "packages",
      "key": "󰏖 packages",
      "keycolor": "yellow"
    },
    {
      "type": "custom",
      "format": "\u001b[90m├─────────────────────────────────────────────────────────────────────┤"
    },
    {
      "type": "memory",
      "key": " memory  ",
      "keycolor": "blue"
    },
    {
      "type": "host",
      "key": "󰾰 host    ",
      "keycolor": "blue"
    },
    {
      "type": "cpu",
      "key": "󰻠 cpu     ",
      "keycolor": "blue"
    },
    {
      "type": "gpu",
      "key": "󰍛 gpu     ",
      "keycolor": "magenta"
    },
    {
      "type": "display",
      "key": "󰍹 display ",
      "keycolor": "blue"
    },
    {
      "type": "swap",
      "key": " swap    ",
      "keycolor": "magenta"
    },
    {
      "type": "disk",
      "key": " disk    ",
      "keycolor": "red"
    },
    {
      "type": "battery",
      "key": " battery ",
      "keycolor": "red"
    },
    {
      "type": "custom",
      "format": "\u001b[90m├─────────────────────────────────────────────────────────────────────┤"
    },
    {
      "type": "uptime",
      "key": "󰅐 uptime  ",
      "keycolor": "yellow"
    },
    {
      "type": "shell",
      "key": " shell   ",
      "keycolor": "yellow"
    },
    {
      "type": "terminal",
      "key": " terminal",
      "keycolor": "yellow"
    },
    {
      "type": "locale",
      "key": " locale  ",
      "keycolor": "yellow"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────────────────────┘"
    },
    {
      "type": "colors",
      "paddingLeft": 24,
      "symbol": "circle",
      "block": {
        "width": 10
      }
    },
    "break"
  ]
}