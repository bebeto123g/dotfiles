window-rule {
    geometry-corner-radius 10 // Set every window radius to 20
    clip-to-geometry true
}

    // if you use steam you will probably like these
window-rule {
    match app-id="steam"
    exclude title=r#"^[Ss]team$"#
    open-floating true
}

window-rule {
    match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
    default-floating-position x=10 y=10 relative-to="bottom-right"
    open-focused false
}

window-rule {
    match app-id="firefox"
    match app-id="obsidian"
    match app-id="code-oss"
    match app-id="mpv"
    // match app-id="Alacritty"
    match app-id="brave-browser"
    // match app-id="^kitty$" title=r#"^[Yy]azi\d+$"#
    match app-id=r#"^kitty$"# title=r#"^Yazi: bebeto$"#
    // match app-id="kitty" title=r#"^Yazi$"#
    open-maximized true
}

layer-rule {
    match namespace="^noctalia-wallpaper*"
    place-within-backdrop true
}
